{
  "name": "kitchenoftech",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade IT & Creative Agency Website with Sanity CMS and Supabase",
  "author": "Kitchen of Tech",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "playwright test accessibility.spec.ts",
    "lighthouse": "node scripts/lighthouse-audit.js",
    "lighthouse:ci": "npm run lighthouse -- --ci",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@hookform/resolvers": "^5.2.2",
    "@portabletext/react": "^6.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sanity/client": "^7.14.0",
    "@sanity/code-input": "^7.0.6",
    "@sanity/color-input": "^6.0.3",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.4.0",
    "@sentry/nextjs": "^10.36.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.18",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.26.2",
    "gsap": "^3.14.2",
    "jspdf": "^4.0.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "next": "16.1.3",
    "next-auth": "^4.24.13",
    "next-sanity": "^12.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "resend": "^6.8.0",
    "sanity": "^5.11.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.3.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.31.0",
    "tailwind-merge": "^3.4.0",
